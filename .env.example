DATABASE_URL=postgres://postgres:postgres@localhost:5432/legisdata
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Persistir y respaldar este directorio junto con PostgreSQL.
LEGISDATA_STORAGE_ROOT=.storage
BCN_DISCOVERY_ENABLED=false

# Explicit demo/test only; production never exposes fixture documents.
LEGISDATA_DATA_MODE=production
LEGISDATA_INGESTION_DAILY_LIMIT=10
LEGISDATA_INGESTION_MINUTE_LIMIT=2
